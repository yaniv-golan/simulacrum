+#[cfg(test)]
+mod review {
+    use super::*;
+    fn vertex(p: Vector, id: f64) -> CsoPoint {
+        let orig2 = Vector::new(id * 100.0, id * 3.0, -id);
+        CsoPoint {
+            point: p,
+            orig1: p + orig2,
+            orig2,
+        }
+    }
+    fn triangle() -> VoronoiSimplex {
+        let mut s = VoronoiSimplex::new();
+        s.reset(vertex(Vector::new(-1.0, -1.0, 1.0), 1.0));
+        s.project_origin_and_reduce();
+        assert!(s.add_point(vertex(Vector::new(1.0, -1.0, 1.0), 2.0)));
+        s.project_origin_and_reduce();
+        assert!(s.add_point(vertex(Vector::new(0.0, 1.0, 1.0), 3.0)));
+        s.project_origin_and_reduce();
+        assert_eq!(s.dimension(), 2);
+        s
+    }
+    fn witnesses(s: &VoronoiSimplex, prev: bool) -> (Vector, Vector) {
+        let mut w = (Vector::ZERO, Vector::ZERO);
+        for i in 0..=if prev {
+            s.prev_dimension()
+        } else {
+            s.dimension()
+        } {
+            let p = if prev { s.prev_point(i) } else { s.point(i) };
+            let c = if prev {
+                s.prev_proj_coord(i)
+            } else {
+                s.proj_coord(i)
+            };
+            w.0 += p.orig1 * c;
+            w.1 += p.orig2 * c;
+        }
+        w
+    }
+    fn face(index: u32) {
+        let a = Vector::new(-1.0, -1.0, 1.0);
+        let b = Vector::new(1.0, -1.0, 1.0);
+        let c = Vector::new(0.0, 1.0, 1.0);
+        let d = [
+            Vector::new(-4.0, -4.0, 2.0),
+            Vector::new(-3.0, 4.0, -2.0),
+            Vector::new(1.0, -3.0, -2.0),
+            Vector::new(-4.0, -4.0, -2.0),
+        ][index as usize];
+        let (_, loc) =
+            Tetrahedron::new(a, b, c, d).project_local_point_and_get_location(Vector::ZERO, true);
+        assert!(
+            matches!(loc,TetrahedronPointLocation::OnFace(i,_) if i==index),
+            "fixture must exercise the named tetrahedron face"
+        );
+        let mut s = triangle();
+        let expected = witnesses(&s, false);
+        assert!(s.add_point(vertex(d, 4.0)));
+        let projection = s.project_origin_and_reduce();
+        assert_eq!(s.dimension(), 2);
+        let current = witnesses(&s, false);
+        assert!(
+            ((current.0 - current.1) - projection).length() < 1e-12,
+            "current projection changed"
+        );
+        let actual = witnesses(&s, true);
+        println!(
+            "face {index} D={d:?} previous witness error={}",
+            (actual.1 - expected.1).length()
+        );
+        assert!(
+            (actual.0 - expected.0).length() < 1e-12,
+            "previous first witness corrupted"
+        );
+        assert!(
+            (actual.1 - expected.1).length() < 1e-12,
+            "previous second witness corrupted"
+        );
+    }
+    #[test]
+    fn face_abc_positive() {
+        face(0)
+    }
+    #[test]
+    fn face_abd() {
+        face(1)
+    }
+    #[test]
+    fn face_acd() {
+        face(2)
+    }
+    #[test]
+    fn face_bcd() {
+        face(3)
+    }
+    #[test]
+    fn overlapping_swaps() {
+        let mut s = triangle();
+        let expected = witnesses(&s, false);
+        assert!(s.add_point(vertex(Vector::new(0.0, 2.0, 0.0), 4.0)));
+        s.swap(0, 1);
+        s.swap(1, 2);
+        let actual = witnesses(&s, true);
+        assert!(
+            (actual.1 - expected.1).length() < 1e-12,
+            "previous witness corrupted by overlapping swaps"
+        );
+    }
