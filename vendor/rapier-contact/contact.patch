+// Locked native rows use MAX as their unbounded sentinel. A finite motor cap
+// is not that sentinel contract and requires the ordinary bounded-row fallback.
+#[cfg(feature = "dim3")]
+fn bilateral_bounds_admitted(bounds: [Real; 2], locked: bool, motor_force: Real, dt: Real) -> bool {
+    if locked {
+        bounds == [-Real::MAX, Real::MAX] || bounds == [-Real::INFINITY, Real::INFINITY]
+    } else if motor_force == Real::MAX || motor_force == Real::INFINITY {
+        let maximum = motor_force * dt;
+        bounds == [-maximum, maximum]
+    } else {
+        false
+    }
+}
