+pub(crate) fn balanced_angular(
+    com1: Vector,
+    com2: Vector,
+    linear: Vector,
+    angular2: Vector,
+) -> [[f64; 3]; 2] {
+    let a = angular2 + (com2 - com1).cross(linear);
+    [[a.x, a.y, a.z], [angular2.x, angular2.y, angular2.z]]
+}
+
+/// Owned numerical response factor. It contains copied rows and mass blocks,
+/// never a live world/body reference. A new value is required after state changes.
+pub struct BilateralResponse {
+    blocks: Vec<[[f64; 6]; 6]>,
+    q: Vec<[[f64; 6]; 2]>,
+    endpoints: Vec<[usize; 2]>,
+    factor: Option<super::solver::SpringFactor>,
+}
+impl BilateralResponse {
+    fn admit(&self, v: &[f64]) -> Result<(), &'static str> {
+        if v.len() != self.blocks.len() * 6 || v.iter().any(|v| !v.is_finite()) {
+            return Err("invalid response vector");
+        }
+        Ok(())
+    }
+    fn multiply(&self, v: &[f64]) -> Vec<f64> {
+        self.blocks
+            .iter()
+            .enumerate()
+            .flat_map(|(body, block)| {
+                block
+                    .iter()
+                    .map(move |row| (0..6).map(|k| row[k] * v[body * 6 + k]).sum::<f64>())
+            })
+            .collect()
+    }
+    /// Return copied correction impulses and velocity changes for a velocity sample.
+    pub fn project(&self, v: &[f64]) -> Result<Vec<f64>, &'static str> {
+        self.admit(v)?;
+        let rhs: Vec<f64> = self
+            .q
+            .iter()
+            .zip(&self.endpoints)
+            .map(|(row, ends)| {
+                (0..2)
+                    .flat_map(|slot| (0..6).map(move |k| row[slot][k] * v[ends[slot] * 6 + k]))
+                    .sum()
+            })
+            .collect();
+        let lambda = match &self.factor {
+            Some(f) => f.solve(&rhs),
+            None => vec![0.0; rhs.len()],
+        };
+        let mut impulse = vec![0.0; v.len()];
+        for ((row, ends), l) in self.q.iter().zip(&self.endpoints).zip(lambda) {
+            for slot in 0..2 {
+                for k in 0..6 {
+                    impulse[ends[slot] * 6 + k] -= row[slot][k] * l;
+                }
+            }
+        }
+        let velocity = self.multiply(&impulse);
+        impulse.extend(velocity);
+        if impulse.iter().any(|x| !x.is_finite()) {
+            return Err("nonfinite projected response");
+        }
+        Ok(impulse)
+    }
+    /// Return copied constrained impulses and velocity changes for a force sample.
+    pub fn response(&self, force: &[f64]) -> Result<Vec<f64>, &'static str> {
+        self.admit(force)?;
+        let free = self.multiply(force);
+        let mut out = self.project(&free)?;
+        for i in 0..force.len() {
+            out[i] += force[i];
+            out[force.len() + i] += free[i];
+        }
+        if out.iter().any(|x| !x.is_finite()) {
+            return Err("nonfinite force response");
+        }
+        Ok(out)
+    }
+}
+
+/// Capture a complete admitted component from the current solver configuration.
+/// Dimensions derive from the existing world, not a second authoring cap.
+pub fn prepare_bilateral_response(
+    bodies: &RigidBodySet,
+    joints: &ImpulseJointSet,
+    body_ids: &[RigidBodyHandle],
+    joint_ids: &[ImpulseJointHandle],
+    base: &IntegrationParameters,
+) -> Result<BilateralResponse, &'static str> {
+    if body_ids.is_empty() || body_ids.len() > bodies.len() || joint_ids.len() > joints.len() {
+        return Err("response capacity");
+    }
+    if base.warmstart_joints {
+        return Err("unsupported warmstarted response");
+    }
+    if !base.dt.is_finite()
+        || base.dt <= 0.0
+        || base.num_solver_iterations == 0
+        || base.num_solver_iterations > 64
+    {
+        return Err("invalid response parameters");
+    }
+    for (i, id) in body_ids.iter().enumerate() {
+        if body_ids[..i].contains(id) {
+            return Err("duplicate response body");
+        }
+        let b = bodies.get(*id).ok_or("unknown response body")?;
+        if !b.is_enabled()
+            || b.is_sleeping()
+            || b.is_kinematic()
+            || b.additional_solver_iterations() != 0
+        {
+            return Err("unsupported response body state");
+        }
+    }
+    for (i, id) in joint_ids.iter().enumerate() {
+        if joint_ids[..i].contains(id) {
+            return Err("duplicate response joint");
+        }
+        let j = joints.get(*id).ok_or("unknown response joint")?;
+        if !j.data.is_enabled() {
+            return Err("disabled response joint");
+        }
+        if !j.data.softness.natural_frequency.is_finite()
+            || j.data.softness.natural_frequency <= 0.0
+            || !j.data.softness.damping_ratio.is_finite()
+            || j.data.softness.damping_ratio < 0.0
+        {
+            return Err("invalid response joint softness");
+        }
+        if !body_ids.contains(&j.body1) || !body_ids.contains(&j.body2) {
+            return Err("response endpoint missing");
+        }
+    }
+    // A queried component may not silently omit one of its attached native joints.
+    for (_, j) in joints.iter() {
+        if (body_ids.contains(&j.body1) || body_ids.contains(&j.body2))
+            && !joint_ids
+                .iter()
+                .any(|id| core::ptr::eq(joints.get(*id).unwrap(), j))
+        {
+            return Err("incomplete response component");
+        }
+    }
+
+    let mut solver = SolverBodies::default();
+    solver.resize(body_ids.len());
+    for (i, id) in body_ids.iter().enumerate() {
+        solver.copy_from(i, &bodies[*id]);
+    }
+    let blocks: Vec<[[f64; 6]; 6]> = solver
+        .poses
+        .iter()
+        .map(|p| {
+            let columns = [Vector::X, Vector::Y, Vector::Z].map(|axis| p.ii.transform_vector(axis));
+            core::array::from_fn(|row| {
+                core::array::from_fn(|col| {
+                    if row < 3 && col < 3 {
+                        if row == col { p.im[row] } else { 0.0 }
+                    } else if row >= 3 && col >= 3 {
+                        columns[col - 3][row - 3]
+                    } else {
+                        0.0
+                    }
+                })
+            })
+        })
+        .collect();
+    let mut nodes = Vec::new();
+    let mut node_ids = Vec::new();
+    let mut ground = None;
+    for (i, id) in body_ids.iter().enumerate() {
+        let node = if bodies[*id].is_fixed() {
+            *ground.get_or_insert_with(|| {
+                nodes.push([[0.0; 6]; 6]);
+                nodes.len() - 1
+            })
+        } else {
+            nodes.push(blocks[i]);
+            nodes.len() - 1
+        };
+        node_ids.push(node);
+    }
+    let mut q = Vec::new();
+    let mut response = Vec::new();
+    let mut cfm = Vec::new();
+    let mut row_bodies = Vec::new();
+    let mut endpoints = Vec::new();
+    let mut edges = Vec::new();
+    let mut params = *base;
+    params.dt /= base.num_solver_iterations as f64;
+    for id in joint_ids {
+        let joint = joints.get(*id).unwrap();
+        // The native active-joint solver emits no rows between two fixed bodies.
+        if bodies[joint.body1].is_fixed() && bodies[joint.body2].is_fixed() {
+            continue;
+        }
+        let a = body_ids.iter().position(|h| *h == joint.body1).unwrap();
+        let b = body_ids.iter().position(|h| *h == joint.body2).unwrap();
+        let mut data = joint.data;
+        data.transform_to_solver_body_space(&bodies[joint.body1], &bodies[joint.body2]);
+        let pa = if bodies[joint.body1].is_fixed() {
+            Default::default()
+        } else {
+            solver.poses[a]
+        };
+        let pb = if bodies[joint.body2].is_fixed() {
+            Default::default()
+        } else {
+            solver.poses[b]
+        };
+        let ja = JointSolverBody {
+            im: pa.im,
+            ii: pa.ii,
+            world_com: pa.translation,
+            solver_vel: [a as u32],
+        };
+        let jb = JointSolverBody {
+            im: pb.im,
+            ii: pb.ii,
+            world_com: pb.translation,
+            solver_vel: [b as u32],
+        };
+        let limits = core::array::from_fn(|i| {
+            AngularLimitParams::new(data.limits[3 + i].min, data.limits[3 + i].max)
+        });
+        let zero = JointConstraint {
+            solver_vel1: [0],
+            solver_vel2: [0],
+            joint_id: [0],
+            impulse: 0.0,
+            impulse_bounds: [0.0; 2],
+            lin_jac: Vector::ZERO,
+            ang_jac1: Vector::ZERO,
+            ang_jac2: Vector::ZERO,
+            ii_ang_jac1: Vector::ZERO,
+            ii_ang_jac2: Vector::ZERO,
+            inv_lhs: 0.0,
+            rhs: 0.0,
+            rhs_wo_bias: 0.0,
+            cfm_gain: 0.0,
+            cfm_coeff: 0.0,
+            im1: Vector::ZERO,
+            im2: Vector::ZERO,
+            writeback_id: WritebackId::Dof(0),
+        };
+        let mut rows = vec![zero; 24];
+        let count = JointConstraint::<f64, 1>::update(
+            &params,
+            0,
+            &ja,
+            &jb,
+            &(pa.pose() * data.local_frame1),
+            &(pb.pose() * data.local_frame2),
+            &data,
+            &limits,
+            &mut rows,
+        );
+
+        let start = q.len();
+        for c in &rows[..count] {
+            if !matches!(c.writeback_id, WritebackId::Dof(_)) {
+                continue;
+            }
+            if c.impulse_bounds != [-f64::MAX, f64::MAX] {
+                return Err("unsupported bounded bilateral row");
+            }
+            let angular = balanced_angular(pa.translation, pb.translation, c.lin_jac, c.ang_jac2);
+            let mut row = [[0.0; 6]; 2];
+            let mut r = row;
+            for (slot, body, sign) in [(0, a, -1.0), (1, b, 1.0)] {
+                for k in 0..3 {
+                    row[slot][k] = sign * c.lin_jac[k];
+                    row[slot][3 + k] = sign * angular[slot][k];
+                }
+                for i in 0..6 {
+                    r[slot][i] = (0..6).map(|j| blocks[body][i][j] * row[slot][j]).sum();
+                }
+            }
+            if !c.cfm_gain.is_finite()
+                || c.cfm_gain < 0.0
+                || row
+                    .iter()
+                    .flatten()
+                    .chain(r.iter().flatten())
+                    .any(|v| !v.is_finite())
+            {
+                return Err("nonfinite response");
+            }
+            q.push(row);
+            response.push(r);
+            cfm.push(c.cfm_gain);
+            endpoints.push([a, b]);
+            row_bodies.push([
+                if bodies[joint.body1].is_fixed() {
+                    usize::MAX
+                } else {
+                    a
+                },
+                if bodies[joint.body2].is_fixed() {
+                    usize::MAX
+                } else {
+                    b
+                },
+            ]);
+        }
+        if q.len() > start {
+            edges.push(([node_ids[a], node_ids[b]], start..q.len()));
+        }
+    }
+    let factor = if q.is_empty() {
+        None
+    } else {
+        Some(super::solver::SpringFactor::new(
+            &q,
+            &response,
+            &row_bodies,
+            &cfm,
+            &edges,
+            &nodes,
+            ground,
+            body_ids.len(),
+        ))
+    };
+    Ok(BilateralResponse {
+        blocks,
+        q,
+        endpoints,
+        factor,
+    })
+}
