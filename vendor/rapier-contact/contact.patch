+#[cfg(feature = "dim3")]
+unsafe fn solve_spring_components(
+    ctx: &SharedCtx,
+    group: &GroupLayout,
+    wo_bias: bool,
+    params: &IntegrationParameters,
+    mut cache: Option<&mut BilateralBatchCache>,
+) -> bool {
+    let builders: Vec<usize> = group.joint_overflow.clone().collect();
+    let joints = unsafe { &*ctx.joint_constraints };
+    let bodies = unsafe { &(*ctx.velocity_solver).solver_bodies };
+    let mut parent: Vec<usize> = (0..builders.len()).collect();
+    let mut owner = vec![usize::MAX; bodies.len()];
+    let mut size = vec![1; builders.len()];
+    fn root(parent: &mut [usize], mut i: usize) -> usize {
+        while parent[i] != i {
+            parent[i] = parent[parent[i]];
+            i = parent[i];
+        }
+        i
+    }
+    for (i, &builder) in builders.iter().enumerate() {
+        for row in ctx.joint_rows[builder].clone() {
+            let c = &joints.velocity_constraints[row];
+            for body in [c.solver_vel1[0] as usize, c.solver_vel2[0] as usize] {
+                if body >= bodies.len() || bodies.poses[body].im.length_squared() == 0.0 {
+                    continue;
+                }
+                if owner[body] == usize::MAX {
+                    owner[body] = i;
+                } else {
+                    let mut a = root(&mut parent, i);
+                    let mut b = root(&mut parent, owner[body]);
+                    if a != b {
+                        if size[a] < size[b] {
+                            std::mem::swap(&mut a, &mut b);
+                        }
+                        parent[b] = a;
+                        size[a] += size[b];
+                    }
+                }
+            }
+        }
+    }
+    let mut components = vec![Vec::new(); builders.len()];
+    for (i, &builder) in builders.iter().enumerate() {
+        components[root(&mut parent, i)].push(builder);
+    }
+    for (index, component) in components.iter().filter(|c| !c.is_empty()).enumerate() {
+        let factor = cache.as_deref_mut().map(|cache| {
+            if index == cache.components.len() {
+                cache.components.push((component.clone(), None));
+            }
+            let entry = &mut cache.components[index];
+            // The ordinal locates an entry, but only exact ordered membership
+            // admits reuse. A changed component gets a fresh factor.
+            if entry.0 != *component {
+                *entry = (component.clone(), None);
+            }
+            &mut entry.1
+        });
+        if !unsafe { solve_spring_component(ctx, component, wo_bias, params, factor) } {
+            let vs = unsafe { &mut *ctx.velocity_solver };
+            let joints = unsafe { &mut *ctx.joint_constraints };
+            for &builder in component {
+                for row in ctx.joint_rows[builder].clone() {
+                    let c = &mut joints.velocity_constraints[row];
+                    if wo_bias {
+                        c.remove_bias_from_rhs();
+                    }
+                    c.solve(&mut vs.solver_bodies);
+                }
+            }
+        }
+    }
+    true
+}
