+#[cfg(test)]
+mod tests {
+    use super::project;
+    #[test]
+    fn disk_solution_matches_independently_constructed_kkt_points() {
+        for (k, expected, mu) in [
+            ([10., 1., 0.], [0.6, 0.8], 2.),
+            ([4., 3., 1.], [0.6, 0.8], 2.),
+            ([4., 3., -1.], [-0.6, 0.8], 2.),
+            ([2., 2., 1.], [0.2, -0.3], 0.),
+        ] {
+            let b = [
+                -(k[0] + mu) * expected[0] - k[2] * expected[1],
+                -k[2] * expected[0] - (k[1] + mu) * expected[1],
+            ];
+            let x = project(k, b, 1.);
+            assert!((x[0] - expected[0]).hypot(x[1] - expected[1]) < 1e-12);
+        }
+    }
+    #[test]
+    fn inactive_and_rank_deficient_metrics_keep_their_convex_solutions() {
+        assert_eq!(project([0.; 3], [0.; 2], 1.), [0.; 2]);
+        let x = project([0.; 3], [-3., -4.], 2.);
+        assert!((x[0] - 1.2).hypot(x[1] - 1.6) < 1e-12);
+        assert_eq!(project([2., 0., 0.], [-1., 0.], 1.), [0.5, 0.]);
+    }
+    #[test]
+    fn physical_interior_impulse_survives_large_radius_scaling() {
+        for (k, b, expected) in [
+            ([1., 1., 0.], [1e-300, 0.], [-1e-300, 0.]),
+            ([2., 2., 1.], [3e-300, 3e-300], [-1e-300, -1e-300]),
+            ([1e-300, 1e-300, 0.], [1e-300, 0.], [-1., 0.]),
+        ] {
+            let x = project(k, b, 1e300);
+            for i in 0..2 {
+                assert!((x[i] - expected[i]).abs() <= expected[i].abs() * 1e-12);
+            }
+        }
+        let x = project([0.; 3], [1e-300, 0.], 1e300);
+        assert!((x[0] / 1e300 + 1.).abs() < 1e-12 && x[1] == 0.);
+    }
+}
