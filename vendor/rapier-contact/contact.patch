+    let mut components = vec![Vec::new(); builders.len()];
+    for (i, &builder) in builders.iter().enumerate() {
+        components[root(&mut parent, i)].push(builder);
+    }
+    for component in components.iter().filter(|c| !c.is_empty()) {
+        if !unsafe { solve_spring_component(ctx, component, wo_bias, params) } {
+            let vs = unsafe { &mut *ctx.velocity_solver };
+            let joints = unsafe { &mut *ctx.joint_constraints };
+            for &builder in component {
+                for row in ctx.joint_rows[builder].clone() {
+                    let c = &mut joints.velocity_constraints[row];
+                    if wo_bias {
+                        c.remove_bias_from_rhs();
+                    }
+                    c.solve(&mut vs.solver_bodies);
+                }
+            }
+        }
+    }
+    true
+}
+
+#[cfg(feature = "dim3")]
+unsafe fn solve_spring_component(
+    ctx: &SharedCtx,
+    builders: &[usize],
+    wo_bias: bool,
+    params: &IntegrationParameters,
+) -> bool {
+    use crate::dynamics::solver::joint_constraint::WritebackId;
+    use crate::utils::AngularInertiaOps;
+    let vs = unsafe { &mut *ctx.velocity_solver };
+    let joints = unsafe { &mut *ctx.joint_constraints };
+    let ids: Vec<usize> = builders
+        .iter()
+        .flat_map(|j| ctx.joint_rows[*j].clone())
+        .collect();
+    // Choose the solve from the authored motor model, independent of coefficients.
+    if !ids.iter().any(|i| {
+        let row = &joints.velocity_constraints[*i];
+        if let WritebackId::Motor(axis) = row.writeback_id {
+            let joint = unsafe { &*ctx.joints.add(row.joint_id[0]) };
+            joint.weight.data.motors[axis].model == crate::dynamics::MotorModel::SymplecticSpring
+        } else {
+            false
+        }
+    }) {
+        return false;
+    }
+    if wo_bias {
+        // Preserve the elastic sample while refreshing lever arms after motion.
+        let old_rhs: Vec<(Real, Real)> = ids
+            .iter()
+            .map(|i| {
+                let c = &joints.velocity_constraints[*i];
+                (c.rhs, c.rhs_wo_bias)
+            })
+            .collect();
+        let JointConstraintsSet {
+            velocity_constraints_builder,
+            velocity_constraints,
+            ..
+        } = joints;
+        for &j in builders {
+            velocity_constraints_builder[j].update(
+                params,
+                1,
+                Some(1.0),
+                &vs.solver_bodies,
+                velocity_constraints,
+            );
+        }
+        for (n, &i) in ids.iter().enumerate() {
+            let c = &mut joints.velocity_constraints[i];
+            if matches!(c.writeback_id, WritebackId::Motor(_)) {
+                c.rhs = old_rhs[n].0;
+                c.rhs_wo_bias = old_rhs[n].1;
+            }
+        }
+    }
+    let unlimited: Vec<usize> = ids
+        .iter()
+        .copied()
+        .filter(|i| {
+            !matches!(
+                joints.velocity_constraints[*i].writeback_id,
+                WritebackId::Limit(_)
+            )
+        })
+        .collect();
+    let n = unlimited.len();
+    let mut bodies = vec![[usize::MAX; 2]; n];
+    let mut q = vec![[[0.0f64; 6]; 2]; n];
+    let mut response = q.clone();
+    let mut rhs = vec![0.0f64; n];
+    for (i, &id) in unlimited.iter().enumerate() {
+        let c = &mut joints.velocity_constraints[id];
+        if wo_bias {
+            c.remove_bias_from_rhs();
+        }
+        rhs[i] = c.rhs as f64 - c.cfm_gain as f64 * c.impulse as f64;
+        for (slot, (body, sign, a, _ia, im)) in [
+            (
+                c.solver_vel1[0] as usize,
+                -1.0,
+                c.ang_jac1,
+                c.ii_ang_jac1,
+                c.im1,
+            ),
+            (
+                c.solver_vel2[0] as usize,
+                1.0,
+                c.ang_jac2,
+                c.ii_ang_jac2,
+                c.im2,
+            ),
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            if body >= vs.solver_bodies.len() {
+                continue;
+            }
+            bodies[i][slot] = body;
+            let vel = &vs.solver_bodies.vels[body];
+            let inertia = vs.solver_bodies.poses[body].ii;
+            let columns = [
+                crate::math::Vector::X,
+                crate::math::Vector::Y,
+                crate::math::Vector::Z,
+            ]
+            .map(|axis| inertia.transform_vector(axis));
+            for k in 0..3 {
+                q[i][slot][k] = sign * c.lin_jac[k] as f64;
+                q[i][slot][3 + k] = sign * a[k] as f64;
+                response[i][slot][k] = sign * c.lin_jac[k] as f64 * im[k] as f64;
+                response[i][slot][3 + k] = sign
+                    * (0..3)
+                        .map(|j| columns[j][k] as f64 * a[j] as f64)
+                        .sum::<f64>();
+                rhs[i] += q[i][slot][k] * vel.linear[k] as f64
+                    + q[i][slot][3 + k] * vel.angular[k] as f64;
+            }
+        }
+    }
+    let cfm: Vec<f64> = unlimited
+        .iter()
+        .map(|&id| joints.velocity_constraints[id].cfm_gain as f64)
+        .collect();
+    let mut node_ids = Vec::new();
+    let mut node_map = vec![usize::MAX; vs.solver_bodies.len()];
+    let mut ground = None;
+    let mut edges = Vec::new();
+    let mut cursor = 0;
+    for &builder in builders {
+        let count = ctx.joint_rows[builder]
+            .clone()
+            .filter(|i| {
+                !matches!(
+                    joints.velocity_constraints[*i].writeback_id,
+                    WritebackId::Limit(_)
+                )
+            })
+            .count();
+        if count == 0 {
+            continue;
+        }
+        assert!(count <= 6, "unsupported spring joint row count");
+        let mut ends = [0; 2];
+        for slot in 0..2 {
+            let body = bodies[cursor][slot];
+            ends[slot] = if body == usize::MAX {
+                *ground.get_or_insert_with(|| {
+                    node_ids.push(usize::MAX);
+                    node_ids.len() - 1
+                })
+            } else {
+                if node_map[body] == usize::MAX {
+                    node_map[body] = node_ids.len();
+                    node_ids.push(body);
+                }
+                node_map[body]
+            };
+        }
+        edges.push((ends, cursor..cursor + count));
+        cursor += count;
+    }
+    assert_eq!(cursor, n);
+    let nodes = node_ids.len();
+    let root = ground.unwrap_or(0);
+    let mut adjacency = vec![Vec::new(); nodes];
+    for (e, (ends, _)) in edges.iter().enumerate() {
+        adjacency[ends[0]].push((e, ends[1]));
+        adjacency[ends[1]].push((e, ends[0]));
+    }
+    let mut parent = vec![usize::MAX; nodes];
+    let mut parent_edge = vec![usize::MAX; nodes];
+    let mut order = vec![root];
+    parent[root] = root;
+    let mut visit = 0;
+    while visit < order.len() {
+        let node = order[visit];
+        visit += 1;
+        for &(edge, next) in &adjacency[node] {
+            if next == parent[node] {
+                continue;
+            }
+            assert_eq!(parent[next], usize::MAX, "cyclic active spring component");
+            parent[next] = node;
+            parent_edge[next] = edge;
+            order.push(next);
+        }
+    }
+    assert_eq!(order.len(), nodes, "disconnected spring component");
+    let mut mass = vec![[[0.0f64; 6]; 6]; nodes];
+    let mut force = vec![[0.0f64; 6]; nodes];
+    for (node, &body) in node_ids.iter().enumerate() {
+        if body == usize::MAX {
+            continue;
+        }
+        let pose = &vs.solver_bodies.poses[body];
+        let mut inverse = [[0.0; 6]; 6];
+        let columns = [
+            crate::math::Vector::X,
+            crate::math::Vector::Y,
+            crate::math::Vector::Z,
+        ]
+        .map(|axis| pose.ii.transform_vector(axis));
+        for i in 0..3 {
+            inverse[i][i] = pose.im[i] as f64;
+            for j in 0..3 {
+                inverse[3 + i][3 + j] = columns[j][i] as f64;
+            }
+        }
+        // A rigid body's translational and angular mass blocks are independent.
+        // Invert the diagonal translation and the three-dimensional inertia
+        // separately; later articulated masses still use the full six rows.
+        let mut angular = [[0.0; 6]; 6];
+        for i in 0..3 {
+            assert!(inverse[i][i] > 0.0 && inverse[i][i].is_finite());
+            mass[node][i][i] = 1.0 / inverse[i][i];
+            for j in 0..3 {
+                angular[i][j] = inverse[3 + i][3 + j];
+            }
+        }
+        let angular_mass = spring_inverse(angular, 3);
+        for i in 0..3 {
+            for j in 0..3 {
+                mass[node][3 + i][3 + j] = angular_mass[i][j];
+            }
+        }
+    }
+    let mut child_inverse = vec![[[0.0f64; 6]; 6]; nodes];
+    let mut edge_inverse = child_inverse.clone();
+    let mut edge_target = force.clone();
+    for &child in order.iter().rev() {
+        if child == root {
+            continue;
+        }
+        let (ends, rows) = &edges[parent_edge[child]];
+        let cs = usize::from(ends[1] == child);
+        let ps = 1 - cs;
+        let p = parent[child];
+        let m = rows.len();
+        let h = spring_inverse(mass[child], 6);
+        child_inverse[child] = h;
+        let hf = spring_mv(&h, &force[child], 6);
+        let mut schur = [[0.0; 6]; 6];
+        let mut target = [0.0; 6];
+        for (i, row) in rows.clone().enumerate() {
+            target[i] = rhs[row] + spring_dot(&q[row][cs], &hf);
+            let hq = spring_mv(&h, &q[row][cs], 6);
+            for (j, other) in rows.clone().enumerate() {
+                schur[i][j] = spring_dot(&q[other][cs], &hq);
+            }
+            schur[i][i] += cfm[row];
+        }
+        let inverse = spring_inverse(schur, m);
+        edge_inverse[child] = inverse;
+        edge_target[child] = target;
+        if p == root && ground.is_some() {
+            continue;
+        }
+        let it = spring_mv(&inverse, &target, m);
+        // Associate Q^T S^-1 Q as two small matrix products rather than
+        // repeating the inner product for every pair of body coordinates.
+        let mut iq = [[0.0; 6]; 6];
+        for i in 0..m {
+            for (j, other) in rows.clone().enumerate() {
+                for b in 0..6 {
+                    if q[other][ps][b] != 0.0 {
+                        iq[i][b] += inverse[i][j] * q[other][ps][b];
+                    }
+                }
+            }
+        }
+        for (i, row) in rows.clone().enumerate() {
+            for a in 0..6 {
+                if q[row][ps][a] == 0.0 {
+                    continue;
+                }
+                force[p][a] -= q[row][ps][a] * it[i];
+                for b in 0..6 {
+                    mass[p][a][b] += q[row][ps][a] * iq[i][b];
+                }
+            }
+        }
+    }
+    let mut velocity = vec![[0.0f64; 6]; nodes];
+    if ground.is_none() {
+        velocity[root] = spring_mv(&spring_inverse(mass[root], 6), &force[root], 6);
+    }
+    let mut delta = vec![0.0f64; n];
+    for &child in &order {
+        if child == root {
+            continue;
+        }
+        let (ends, rows) = &edges[parent_edge[child]];
+        let cs = usize::from(ends[1] == child);
+        let ps = 1 - cs;
+        let p = parent[child];
+        let m = rows.len();
+        let mut target = edge_target[child];
+        for (i, row) in rows.clone().enumerate() {
+            target[i] += spring_dot(&q[row][ps], &velocity[p]);
+        }
+        let impulse = spring_mv(&edge_inverse[child], &target, m);
+        let mut f = force[child];
+        for (i, row) in rows.clone().enumerate() {
+            delta[row] = impulse[i];
+            for k in 0..6 {
+                f[k] -= q[row][cs][k] * impulse[i];
+            }
+        }
+        velocity[child] = spring_mv(&child_inverse[child], &f, 6);
+    }
+    // Iterative refinement reuses the tree factors and checks the original
+    // equations. It corrects cancellation without relaxing the error bound.
+    let roundoff = 1024.0 * n as f64 * f64::EPSILON;
+    let tolerance = roundoff / (1.0 - roundoff);
+    for refinement in 0..=3 {
+        let mut response_sum = vec![[0.0f64; 6]; vs.solver_bodies.len()];
+        let mut absolute_sum = response_sum.clone();
+        for i in 0..n {
+            for slot in 0..2 {
+                let body = bodies[i][slot];
+                if body == usize::MAX {
+                    continue;
+                }
+                for k in 0..6 {
+                    let value = response[i][slot][k] * delta[i];
+                    response_sum[body][k] += value;
+                    absolute_sum[body][k] += value.abs();
+                }
+            }
+        }
+        let mut residual = vec![0.0; n];
+        let mut accurate = true;
+        for i in 0..n {
+            let mut actual = cfm[i] * delta[i];
+            let mut scale = rhs[i].abs() + actual.abs();
+            for slot in 0..2 {
+                let body = bodies[i][slot];
+                if body == usize::MAX {
+                    continue;
+                }
+                actual += spring_dot(&q[i][slot], &response_sum[body]);
+                for k in 0..6 {
+                    scale += q[i][slot][k].abs() * absolute_sum[body][k];
+                }
+            }
+            residual[i] = rhs[i] - actual;
+            accurate &= actual.is_finite() && residual[i].abs() <= tolerance * scale;
+        }
+        if accurate {
+            break;
+        }
+        assert!(
+            refinement < 3,
+            "coupled spring tree backward error failed after refinement"
+        );
+        force.fill([0.0; 6]);
+        for &child in order.iter().rev() {
+            if child == root {
+                continue;
+            }
+            let (ends, rows) = &edges[parent_edge[child]];
+            let cs = usize::from(ends[1] == child);
+            let ps = 1 - cs;
+            let p = parent[child];
+            let m = rows.len();
+            let hf = spring_mv(&child_inverse[child], &force[child], 6);
+            let mut target = [0.0; 6];
+            for (i, row) in rows.clone().enumerate() {
+                target[i] = residual[row] + spring_dot(&q[row][cs], &hf);
+            }
+            edge_target[child] = target;
+            if p == root && ground.is_some() {
+                continue;
+            }
+            let it = spring_mv(&edge_inverse[child], &target, m);
+            for (i, row) in rows.clone().enumerate() {
+                for k in 0..6 {
+                    force[p][k] -= q[row][ps][k] * it[i];
+                }
+            }
+        }
+        velocity.fill([0.0; 6]);
+        if ground.is_none() {
+            velocity[root] = spring_mv(&spring_inverse(mass[root], 6), &force[root], 6);
+        }
+        for &child in &order {
+            if child == root {
+                continue;
+            }
+            let (ends, rows) = &edges[parent_edge[child]];
+            let cs = usize::from(ends[1] == child);
+            let ps = 1 - cs;
+            let p = parent[child];
+            let m = rows.len();
+            let mut target = edge_target[child];
+            for (i, row) in rows.clone().enumerate() {
+                target[i] += spring_dot(&q[row][ps], &velocity[p]);
+            }
+            let impulse = spring_mv(&edge_inverse[child], &target, m);
+            let mut f = force[child];
+            for (i, row) in rows.clone().enumerate() {
+                delta[row] += impulse[i];
+                for k in 0..6 {
+                    f[k] -= q[row][cs][k] * impulse[i];
+                }
+            }
+            velocity[child] = spring_mv(&child_inverse[child], &f, 6);
+        }
+    }
+    for (i, &id) in unlimited.iter().enumerate() {
+        let c = &mut joints.velocity_constraints[id];
+        let total = (c.impulse as f64 + delta[i])
+            .clamp(c.impulse_bounds[0] as f64, c.impulse_bounds[1] as f64);
+        delta[i] = total - c.impulse as f64;
+        c.impulse = total as Real;
+    }
+    let mut velocity_delta = vec![[0.0f64; 6]; vs.solver_bodies.len()];
+    for i in 0..n {
+        for slot in 0..2 {
+            let body = bodies[i][slot];
+            if body == usize::MAX {
+                continue;
+            }
+            for k in 0..6 {
+                velocity_delta[body][k] += response[i][slot][k] * delta[i];
+            }
+        }
+    }
+    for (body, change) in velocity_delta.iter().enumerate() {
+        for k in 0..3 {
+            vs.solver_bodies.vels[body].linear[k] -= change[k] as Real;
+            vs.solver_bodies.vels[body].angular[k] -= change[3 + k] as Real;
+        }
+    }
+    for id in ids {
+        let c = &mut joints.velocity_constraints[id];
+        if matches!(c.writeback_id, WritebackId::Limit(_)) {
+            if wo_bias {
+                c.remove_bias_from_rhs();
+            }
+            c.solve(&mut vs.solver_bodies);
+        }
+    }
+    true
+}
+
+#[cfg(feature = "dim3")]
+fn spring_dot(a: &[f64; 6], b: &[f64; 6]) -> f64 {
+    (0..6).map(|i| a[i] * b[i]).sum()
+}
+#[cfg(feature = "dim3")]
+fn spring_mv(a: &[[f64; 6]; 6], b: &[f64; 6], n: usize) -> [f64; 6] {
+    let mut out = [0.0; 6];
+    for i in 0..n {
+        for j in 0..n {
+            out[i] += a[i][j] * b[j];
+        }
+    }
+    out
+}
+#[cfg(feature = "dim3")]
+fn spring_inverse(a: [[f64; 6]; 6], n: usize) -> [[f64; 6]; 6] {
+    let mut scale = [1.0f64; 6];
+    for i in 0..n {
+        assert!(
+            a[i][i] > 0.0 && a[i][i].is_finite(),
+            "invalid spring factor diagonal"
+        );
+        scale[i] = a[i][i].sqrt();
+    }
+    let mut l = [[0.0f64; 6]; 6];
+    for i in 0..n {
+        for j in 0..=i {
+            let mut value = a[i][j] / (scale[i] * scale[j]);
+            for k in 0..j {
+                value -= l[i][k] * l[j][k];
+            }
+            if i == j {
+                assert!(value > 0.0 && value.is_finite(), "singular spring factor");
+                l[i][j] = value.sqrt();
+            } else {
+                l[i][j] = value / l[j][j];
+            }
+        }
+    }
+    let mut inverse = [[0.0f64; 6]; 6];
+    for column in 0..n {
+        let mut x = [0.0; 6];
+        for i in 0..n {
+            let mut value = if i == column { 1.0 } else { 0.0 };
+            for k in 0..i {
+                value -= l[i][k] * x[k];
+            }
+            x[i] = value / l[i][i];
+        }
+        for i in (0..n).rev() {
+            let mut value = x[i];
+            for k in i + 1..n {
+                value -= l[k][i] * x[k];
+            }
+            x[i] = value / l[i][i];
+        }
+        for i in 0..n {
+            inverse[i][column] = x[i] / (scale[i] * scale[column]);
+        }
+    }
+    inverse
+}
