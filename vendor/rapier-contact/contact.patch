+        let nodes = inverse_mass.len();
+        let root = ground.unwrap_or(0);
+        let mut adjacency = vec![Vec::new(); nodes];
+        for &e in selected {
+            let ends = edges[e].0;
+            adjacency[ends[0]].push((e, ends[1]));
+            adjacency[ends[1]].push((e, ends[0]));
+        }
+        let mut parent = vec![usize::MAX; nodes];
+        let mut parent_edge = parent.clone();
+        let mut order = vec![root];
+        parent[root] = root;
+        let mut cursor = 0;
+        while cursor < order.len() {
+            let node = order[cursor];
+            cursor += 1;
+            for &(edge, next) in &adjacency[node] {
+                if edge == parent_edge[node] {
+                    continue;
+                }
+                assert_eq!(parent[next], usize::MAX, "cyclic spanning tree");
+                parent[next] = node;
+                parent_edge[next] = edge;
+                order.push(next);
+            }
+        }
+        assert_eq!(order.len(), nodes, "disconnected cyclic spring component");
+        let mut mass = vec![[[0.0; 6]; 6]; nodes];
+        for node in 0..nodes {
+            if Some(node) != ground {
+                mass[node] = spring_inverse(inverse_mass[node], 6);
+            }
+        }
+        let mut child_inverse = vec![[[0.0; 6]; 6]; nodes];
+        let mut edge_inverse = child_inverse.clone();
+        for &child in order.iter().rev() {
+            if child == root {
+                continue;
+            }
+            let (ends, rows) = &edges[parent_edge[child]];
+            let cs = usize::from(ends[1] == child);
+            let ps = 1 - cs;
+            let p = parent[child];
+            let m = rows.len();
+            assert!(m > 0 && m <= 6);
+            let h = spring_inverse(mass[child], 6);
+            child_inverse[child] = h;
+            let mut schur = [[0.0; 6]; 6];
+            for (i, row) in rows.clone().enumerate() {
+                let hq = spring_mv(&h, &q[row][cs], 6);
+                for (j, other) in rows.clone().enumerate() {
+                    schur[i][j] = spring_dot(&q[other][cs], &hq);
+                }
+                schur[i][i] += cfm[row];
+            }
