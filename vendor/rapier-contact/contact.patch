+#[cfg(feature = "dim3")]
+unsafe fn solve_spring_component(
+    ctx: &SharedCtx,
+    builders: &[usize],
+    wo_bias: bool,
+    params: &IntegrationParameters,
+    mut cache: Option<&mut Option<BilateralFactor>>,
