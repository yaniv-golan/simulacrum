+#[cfg(feature = "dim3")]
+fn spring_dot(a: &[f64; 6], b: &[f64; 6]) -> f64 {
+    (0..6).map(|i| a[i] * b[i]).sum()
+}
+#[cfg(feature = "dim3")]
+fn spring_mv(a: &[[f64; 6]; 6], b: &[f64; 6], n: usize) -> [f64; 6] {
+    let mut out = [0.0; 6];
+    for i in 0..n {
+        for j in 0..n {
+            out[i] += a[i][j] * b[j];
+        }
+    }
+    out
+}
+#[cfg(feature = "dim3")]
+fn spring_inverse(a: [[f64; 6]; 6], n: usize) -> [[f64; 6]; 6] {
+    let mut scale = [1.0f64; 6];
+    for i in 0..n {
+        assert!(
+            a[i][i] > 0.0 && a[i][i].is_finite(),
+            "invalid spring factor diagonal"
+        );
+        scale[i] = a[i][i].sqrt();
+    }
+    let mut l = [[0.0f64; 6]; 6];
+    for i in 0..n {
+        for j in 0..=i {
+            let mut value = a[i][j] / (scale[i] * scale[j]);
+            for k in 0..j {
+                value -= l[i][k] * l[j][k];
+            }
+            if i == j {
+                assert!(value > 0.0 && value.is_finite(), "singular spring factor");
+                l[i][j] = value.sqrt();
+            } else {
+                l[i][j] = value / l[j][j];
+            }
+        }
+    }
+    let mut inverse = [[0.0f64; 6]; 6];
+    for column in 0..n {
+        let mut x = [0.0; 6];
+        for i in 0..n {
+            let mut value = if i == column { 1.0 } else { 0.0 };
+            for k in 0..i {
+                value -= l[i][k] * x[k];
+            }
+            x[i] = value / l[i][i];
+        }
+        for i in (0..n).rev() {
+            let mut value = x[i];
+            for k in i + 1..n {
+                value -= l[k][i] * x[k];
+            }
+            x[i] = value / l[i][i];
+        }
+        for i in 0..n {
+            inverse[i][column] = x[i] / (scale[i] * scale[column]);
+        }
+    }
+    inverse
+}
