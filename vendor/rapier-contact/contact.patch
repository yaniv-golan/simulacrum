+            let impulse = spring_mv(&self.edge_inverse[child], &target, rows.len());
+            let mut f = force[child];
+            for (i, row) in rows.clone().enumerate() {
+                delta[row] = impulse[i];
+                for k in 0..6 {
+                    f[k] -= self.q[row][cs][k] * impulse[i];
+                }
+            }
+            velocity[child] = spring_mv(&self.child_inverse[child], &f, 6);
+        }
+        delta
+    }
+}
+
+// Only the loop border is dense. Diagonal scaling makes mixed linear/angular
+// units explicit; nonpositive pivots fail instead of deleting redundant rows.
+struct Border {
+    l: Vec<Vec<f64>>,
+    scale: Vec<f64>,
+}
+impl Border {
+    fn factor(a: Vec<Vec<f64>>) -> Self {
+        let n = a.len();
+        let scale: Vec<_> = (0..n)
+            .map(|i| {
+                assert!(
+                    a[i][i] > 0.0 && a[i][i].is_finite(),
+                    "invalid spring border diagonal"
+                );
+                a[i][i].sqrt()
+            })
+            .collect();
+        let mut l = vec![vec![0.0; n]; n];
+        for i in 0..n {
+            for j in 0..=i {
+                let mut value = a[i][j] / (scale[i] * scale[j]);
+                for k in 0..j {
+                    value -= l[i][k] * l[j][k];
+                }
+                if i == j {
+                    assert!(value > 0.0 && value.is_finite(), "singular spring border");
+                    l[i][j] = value.sqrt();
+                } else {
+                    l[i][j] = value / l[j][j];
+                }
+            }
+        }
+        Self { l, scale }
+    }
+    fn solve(&self, b: &[f64]) -> Vec<f64> {
+        let n = b.len();
+        let mut x = vec![0.0; n];
+        for i in 0..n {
+            let mut v = b[i] / self.scale[i];
+            for k in 0..i {
+                v -= self.l[i][k] * x[k];
+            }
+            x[i] = v / self.l[i][i];
+        }
+        for i in (0..n).rev() {
+            let mut v = x[i];
+            for k in i + 1..n {
+                v -= self.l[k][i] * x[k];
+            }
+            x[i] = v / self.l[i][i];
+        }
+        for i in 0..n {
+            x[i] /= self.scale[i];
+        }
+        x
+    }
+}
+
+pub(super) fn solve(
+    q: &[[V; 2]],
+    response: &[[V; 2]],
+    bodies: &[[usize; 2]],
+    cfm: &[f64],
+    rhs: &[f64],
+    edges: &[Edge],
+    inverse_mass: &[M],
+    ground: Option<usize>,
+    body_count: usize,
+) -> Vec<f64> {
+    SpringFactor::new(
+        q,
+        response,
+        bodies,
+        cfm,
+        edges,
+        inverse_mass,
+        ground,
+        body_count,
+    )
+    .solve(rhs)
+}
+
+pub(crate) struct SpringFactor {
+    q: Vec<[V; 2]>,
+    response: Vec<[V; 2]>,
+    bodies: Vec<[usize; 2]>,
+    cfm: Vec<f64>,
+    tree: Tree,
+    chords: Vec<usize>,
+    coupling: Vec<Vec<f64>>,
+    columns: Vec<Vec<f64>>,
+    border: Border,
+    body_count: usize,
+    edges: Vec<Edge>,
+}
+impl SpringFactor {
+    pub(crate) fn new(
+        q: &[[V; 2]],
+        response: &[[V; 2]],
+        bodies: &[[usize; 2]],
