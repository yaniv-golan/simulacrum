+// Bounded block-Jacobi correction: at most six rows from one native joint.
+// Never assembles a component matrix and never omits inter-joint terms from
+// the full residual used to accept the correction.
+pub(super) fn block_correction(
+    q: &[[V; 2]],
+    response: &[[V; 2]],
+    bodies: &[[usize; 2]],
+    cfm: &[f64],
+    edges: &[Edge],
+    residual: &[f64],
+) -> Vec<f64> {
+    let mut correction = vec![0.0; residual.len()];
+    for (_, rows) in edges {
+        let mut matrix = [[0.0; 6]; 6];
+        let mut rhs = [0.0; 6];
+        for (i, row) in rows.clone().enumerate() {
+            rhs[i] = residual[row];
+            for (j, column) in rows.clone().enumerate() {
+                matrix[i][j] = if row == column { cfm[row] } else { 0.0 };
+                for a in 0..2 {
+                    for b in 0..2 {
+                        if bodies[row][a] != usize::MAX && bodies[row][a] == bodies[column][b] {
+                            matrix[i][j] += spring_dot(&q[row][a], &response[column][b]);
+                        }
+                    }
+                }
+            }
+        }
+        let delta = spring_mv(&spring_inverse(matrix, rows.len()), &rhs, rows.len());
+        for (i, row) in rows.clone().enumerate() {
+            correction[row] = delta[i];
+        }
+    }
+    correction
+}
