+struct Tree {
+    q: Vec<[V; 2]>,
+    edges: Vec<Edge>,
+    order: Vec<usize>,
+    parent: Vec<usize>,
+    parent_edge: Vec<usize>,
+    child_inverse: Vec<M>,
+    edge_inverse: Vec<M>,
+    root_inverse: M,
+    root: usize,
+}
+
+impl Tree {
+    fn factor(
+        q: &[[V; 2]],
+        cfm: &[f64],
+        edges: &[Edge],
+        selected: &[usize],
+        inverse_mass: &[M],
+        ground: Option<usize>,
