+        let mut rank = vec![0u32; nodes];
+        let mut selected = Vec::new();
+        let mut chords = Vec::new();
+        // Stable input edge order defines a spanning tree, never which rows survive.
+        for (e, (ends, rows)) in edges.iter().enumerate() {
+            let a = representative(&mut component, ends[0]);
+            let b = representative(&mut component, ends[1]);
+            if a == b {
+                chords.extend(rows.clone());
+            } else {
+                selected.push(e);
+                if rank[a] < rank[b] {
+                    component[a] = b;
+                } else {
+                    component[b] = a;
+                    if rank[a] == rank[b] {
+                        rank[a] += 1;
+                    }
+                }
+            }
+        }
+        assert_eq!(selected.len() + 1, nodes, "disconnected spring border");
+        let tree = Tree::factor(q, cfm, edges, &selected, inverse_mass, ground);
+        let entry = |i: usize, j: usize| {
+            let mut value = if i == j { cfm[i] } else { 0.0 };
+            for a in 0..2 {
+                if bodies[i][a] == usize::MAX {
+                    continue;
+                }
+                for b in 0..2 {
+                    if bodies[i][a] == bodies[j][b] {
+                        value += spring_dot(&q[i][a], &response[j][b]);
+                    }
+                }
+            }
+            value
+        };
+        let coupling: Vec<Vec<f64>> = chords
+            .iter()
+            .map(|&j| (0..n).map(|i| entry(i, j)).collect())
+            .collect();
+        let columns: Vec<_> = coupling.iter().map(|b| tree.solve(b)).collect();
+        let mut border = vec![vec![0.0; chords.len()]; chords.len()];
+        for (i, &row) in chords.iter().enumerate() {
+            for (j, &column) in chords.iter().enumerate() {
+                border[i][j] = entry(row, column)
+                    - coupling[i]
+                        .iter()
+                        .zip(&columns[j])
+                        .map(|(a, b)| a * b)
+                        .sum::<f64>();
+            }
+        }
+        let border = Border::factor(border);
+        Self {
+            q: q.to_vec(),
+            response: response.to_vec(),
+            bodies: bodies.to_vec(),
+            cfm: cfm.to_vec(),
+            tree,
+            chords,
+            coupling,
+            columns,
+            border,
+            body_count,
+            edges: edges.to_vec(),
+        }
+    }
+    fn solve_rhs(&self, b: &[f64]) -> Vec<f64> {
+        let Self {
+            tree,
+            chords,
+            coupling,
+            columns,
+            border,
+            ..
+        } = self;
+        let n = self.cfm.len();
+        let mut delta = tree.solve(b);
+        let target: Vec<_> = chords
+            .iter()
+            .enumerate()
+            .map(|(i, &row)| {
+                b[row]
+                    - coupling[i]
+                        .iter()
+                        .zip(&delta)
+                        .map(|(a, b)| a * b)
+                        .sum::<f64>()
+            })
+            .collect();
+        let correction = border.solve(&target);
+        for (j, &row) in chords.iter().enumerate() {
+            for i in 0..n {
+                delta[i] -= columns[j][i] * correction[j];
+            }
+            delta[row] = correction[j];
+        }
+        delta
+    }
+    pub(crate) fn solve(&self, rhs: &[f64]) -> Vec<f64> {
+        let Self {
+            q,
+            response,
+            bodies,
+            cfm,
+            body_count,
+            ..
+        } = self;
+        let body_count = *body_count;
+        let n = cfm.len();
+        assert_eq!(rhs.len(), n);
+        let mut delta = self.solve_rhs(rhs);
+        // Strict original-equation check, not the Schur system: CFM and every
+        // endpoint response participate, with the existing tree bound unchanged.
+        let roundoff = 1024.0 * n as f64 * f64::EPSILON;
+        assert!(roundoff < 1.0);
+        let tolerance = roundoff / (1.0 - roundoff);
+        for refinement in 0..=3 {
+            let mut response_sum = vec![[0.0; 6]; body_count];
+            let mut absolute_sum = response_sum.clone();
+            for i in 0..n {
+                for slot in 0..2 {
+                    let body = bodies[i][slot];
+                    if body == usize::MAX {
+                        continue;
+                    }
+                    for k in 0..6 {
+                        let value = response[i][slot][k] * delta[i];
+                        response_sum[body][k] += value;
+                        absolute_sum[body][k] += value.abs();
+                    }
+                }
+            }
+            let mut residual = vec![0.0; n];
+            let mut accurate = true;
+            for i in 0..n {
+                let mut actual = cfm[i] * delta[i];
+                let mut scale = rhs[i].abs() + actual.abs();
+                for slot in 0..2 {
+                    let body = bodies[i][slot];
+                    if body == usize::MAX {
+                        continue;
+                    }
+                    actual += spring_dot(&q[i][slot], &response_sum[body]);
+                    for k in 0..6 {
+                        scale += q[i][slot][k].abs() * absolute_sum[body][k];
+                    }
+                }
+                residual[i] = rhs[i] - actual;
+                accurate &= actual.is_finite() && residual[i].abs() <= tolerance * scale;
+            }
+            // A nonzero cyclic solve receives at least one full-equation correction:
+            // passing a backward bound alone can hide border cancellation error.
+            if accurate && (refinement > 0 || residual.iter().all(|v| *v == 0.0)) {
+                return delta;
+            }
+            assert!(
+                refinement < 3,
+                "coupled spring border backward error failed after refinement"
+            );
+            let correction = if refinement == 2 {
+                block_correction(q, response, bodies, cfm, &self.edges, &residual)
+            } else {
+                self.solve_rhs(&residual)
+            };
+            for i in 0..n {
+                delta[i] += correction[i];
+            }
+        }
+        unreachable!()
+    }
+}
