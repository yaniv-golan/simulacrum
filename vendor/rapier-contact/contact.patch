+//! Minimize a positive-semidefinite two-dimensional quadratic over a Coulomb disk.
+//! All coordinates are numeric; the contact's accumulated impulse enters through b.
+pub(crate) fn project(k: [f64; 3], b: [f64; 2], limit: f64) -> [f64; 2] {
+    assert!(limit.is_finite() && limit >= 0.0);
+    assert!(k.iter().chain(b.iter()).all(|x| x.is_finite()));
+    if limit == 0.0 {
+        return [0.0; 2];
+    }
+    // Preserve representable interior impulses before dividing by a possibly huge
+    // radius: a unit-disk coordinate may underflow even when its physical impulse does not.
+    if k[2] == 0.0 && k[0] >= 0.0 && k[1] >= 0.0 {
+        let free = std::array::from_fn::<_, 2, _>(|i| if b[i] == 0.0 { 0.0 } else { -b[i] / k[i] });
+        if free.iter().all(|x| x.is_finite()) && free[0].hypot(free[1]) <= limit {
+            return free;
+        }
+    }
+    let metric_scale = k.iter().fold(0.0_f64, |a, x| a.max(x.abs()));
+    if metric_scale > 0.0 {
+        let [a, c, h] = k.map(|x| x / metric_scale);
+        let g = b.map(|x| x / metric_scale);
+        let det = a.mul_add(c, -h * h);
+        if a >= 0.0 && c >= 0.0 && det > 0.0 && g.iter().all(|x| x.is_finite()) {
+            let free = [(h * g[1] - c * g[0]) / det, (h * g[0] - a * g[1]) / det];
+            let norm = free[0].hypot(free[1]);
+            let residual =
+                (a * free[0] + h * free[1] + g[0]).hypot(h * free[0] + c * free[1] + g[1]);
+            let bound = 256.0
+                * f64::EPSILON
+                * ((a.abs() + c.abs() + 2.0 * h.abs()) * norm + g[0].hypot(g[1]));
+            if free.iter().all(|x| x.is_finite()) && norm <= limit && residual <= bound {
+                return free;
+            }
+        }
+    }
+    let original_scale = k
+        .iter()
+        .chain(b.iter())
+        .fold(0.0_f64, |a, x| a.max(x.abs()));
+    if original_scale == 0.0 {
+        return [0.0; 2];
+    }
+    let k = k.map(|x| x / original_scale);
+    let b = b.map(|x| x / original_scale);
+    // Work on the unit disk. These homogeneous forms avoid overflow in K*limit
+    // and b/limit, respectively. No coefficients are compared with a unit cutoff.
+    let (metric, linear) = if limit >= 1.0 {
+        (k, b.map(|x| x / limit))
+    } else {
+        (k.map(|x| x * limit), b)
+    };
+    let scale = metric
+        .iter()
+        .chain(linear.iter())
+        .fold(0.0_f64, |a, x| a.max(x.abs()));
+    if scale == 0.0 {
+        return [0.0; 2];
+    }
+    let [a, c, h] = metric.map(|x| x / scale);
+    let linear = linear.map(|x| x / scale);
+    let det = a.mul_add(c, -h * h);
+    // A contact metric is a Gram matrix; tolerate only a backward error
+    // at matrix scale (including input coefficient underflow), then certify
+    // the result against the original unmodified coefficients below.
+    let det_roundoff = 4.0 * f64::EPSILON * (a + c).powi(2);
+    assert!(a >= 0.0 && c >= 0.0 && det >= -det_roundoff, "indefinite friction metric k={k:?} b={b:?} limit={limit} scaled={a},{c},{h} det={det} roundoff={det_roundoff}");
+    let high = 0.5 * (a + c + (a - c).hypot(2.0 * h));
+    let low = if high == 0.0 {
+        0.0
+    } else {
+        det.max(0.0) / high
+    };
+    let angle = 0.5 * (2.0 * h).atan2(a - c);
+    let (s, t) = angle.sin_cos();
+    let f = [
+        -t * linear[0] - s * linear[1],
+        s * linear[0] - t * linear[1],
+    ];
+    let eigen = [high, low];
+    let value = |mu: f64| {
+        std::array::from_fn::<_, 2, _>(|i| {
+            if f[i] == 0.0 {
+                0.0
+            } else {
+                f[i] / (eigen[i] + mu)
+            }
+        })
+    };
+    let tolerance = 256.0 * f64::EPSILON;
+    let mut mu = 0.0;
+    let mut x = value(mu);
+    if x[0].hypot(x[1]) > 1.0 {
+        let mut lower = 0.0;
+        let mut upper = f[0].hypot(f[1]);
+        // If one free coordinate already fits, reserving its free magnitude
+        // yields a tighter valid upper bound even for extreme eigenvalue ratios.
+        for i in 0..2 {
+            if x[i].abs() < 1.0 {
+                let remaining = ((1.0 - x[i].abs()) * (1.0 + x[i].abs())).sqrt();
+                let candidate = (f[1 - i].abs() / remaining - eigen[1 - i]).max(0.0);
+                if candidate > 0.0 {
+                    upper = upper.min(candidate);
+                }
+            }
+        }
+        assert!(upper.is_finite() && upper > 0.0, "invalid friction bracket");
+        mu = upper;
+        for iteration in 0..128 {
+            x = value(mu);
+            let norm = x[0].hypot(x[1]);
+            if norm.is_finite() && (norm - 1.0).abs() <= tolerance {
+                break;
+            }
+            if norm > 1.0 {
+                lower = mu;
+            } else {
+                upper = mu;
+            }
+            let derivative =
+                -(x[0] / norm * (x[0] / (eigen[0] + mu)) + x[1] / norm * (x[1] / (eigen[1] + mu)));
+            let proposed = mu - (norm - 1.0) / derivative;
+            mu = if proposed.is_finite() && proposed > lower && proposed < upper {
+                proposed
+            } else {
+                lower + (upper - lower) * 0.5
+            };
+            assert!(iteration < 127, "friction secular solve failed");
+        }
+    }
+    let unit = [t * x[0] - s * x[1], s * x[0] + t * x[1]];
+    let norm = unit[0].hypot(unit[1]);
+    assert!(
+        unit.iter().all(|x| x.is_finite()) && norm <= 1.0 + tolerance * 2.0,
+        "friction cone residual"
+    );
+    let residual = [
+        a * unit[0] + h * unit[1] + linear[0] + mu * unit[0],
+        h * unit[0] + c * unit[1] + linear[1] + mu * unit[1],
+    ];
+    let bound =
+        tolerance * ((a.abs() + c.abs() + 2.0 * h.abs() + mu) * norm + linear[0].hypot(linear[1]));
+    assert!(
+        residual[0].hypot(residual[1]) <= bound,
+        "friction KKT residual: k={k:?} b={b:?} limit={limit} residual={residual:?} bound={bound}"
+    );
+    let result = unit.map(|x| x * limit);
+    assert!(
+        result.iter().all(|x| x.is_finite()),
+        "nonfinite friction impulse"
+    );
+    result
+}
