{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "simulacrum-release-control-local",
  "main": "release-control.mjs",
  "compatibility_date": "2026-09-07",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false },
    "traces": { "enabled": false },
  },
  "durable_objects": { "bindings": [{ "name": "PUBLISHER", "class_name": "ReleaseCoordinator" }] },
  "migrations": [{ "tag": "publisher-v1", "new_sqlite_classes": ["ReleaseCoordinator"] }],
}
