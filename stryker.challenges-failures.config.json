{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "ignorePatterns": [
    "/artifacts",
    "/coverage",
    "/dist",
    "/output",
    "/packages/core/dist",
    "/temp"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "node scripts/verify-challenges-failure-quality.mjs"
  },
  "mutate": [
    "src/model/challenge-reference-controls.js",
    "src/model/challenge-evaluators.js",
    "src/model/challenge-score.js",
    "src/model/challenge-lab.js",
    "src/model/failure-event-extractors.js",
    "src/model/failure-analysis.js"
  ],
  "coverageAnalysis": "off",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayDeclaration",
      "ObjectLiteral",
      "OptionalChaining",
      "MethodExpression",
      "ArrowFunction"
    ]
  },
  "concurrency": 4,
  "timeoutMS": 10000,
  "tempDirName": "artifacts/stryker-challenges-failures",
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": "artifacts/challenges-failures-mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 80,
    "break": 80
  }
}
