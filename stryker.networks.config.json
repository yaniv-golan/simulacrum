{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "ignorePatterns": [
    "/artifacts",
    "/coverage",
    "/dist",
    "/output",
    "/packages/core/dist",
    "/temp"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "node scripts/verify-component-route-evidence.mjs && node scripts/verify-power-signal-command-networks.mjs && node scripts/verify-material-resources.mjs && node scripts/verify-conserved-propulsion.mjs && node scripts/verify-controller-bindings.mjs && node scripts/verify-release-coupler.mjs"
  },
  "mutate": [
    "src/application/remote-control-read-model.js",
    "src/application/remote-control-state.js",
    "src/simulation/energy-ledger.js",
    "src/model/actuator-contracts.js:64-152",
    "src/model/material-resource-contracts.js",
    "src/simulation/command-bus.js",
    "src/simulation/power-network.js",
    "src/simulation/signal-network.js",
    "src/simulation/material-resource-network.js",
    "src/simulation/route-evidence-index.js",
    "src/simulation/route-evidence-archive.js",
    "src/simulation/systems/telemetry-system.js",
    "src/simulation/systems/command-routing-system.js",
    "src/simulation/systems/release-coupler-system.js"
  ],
  "coverageAnalysis": "off",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayDeclaration",
      "ObjectLiteral",
      "OptionalChaining",
      "MethodExpression",
      "ArrowFunction"
    ]
  },
  "concurrency": 4,
  "timeoutMS": 10000,
  "tempDirName": "artifacts/stryker-networks",
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": "artifacts/networks-mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 80,
    "break": 80
  }
}
