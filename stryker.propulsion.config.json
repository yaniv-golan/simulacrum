{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "ignorePatterns": [
    "/artifacts",
    "/coverage",
    "/dist",
    "/output",
    "/packages/core/dist",
    "/temp"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "node scripts/verify-conserved-propulsion.mjs && node scripts/verify-flight-runtime-budget.mjs"
  },
  "mutate": [
    "src/model/material-media.js",
    "src/model/pressure-nozzle-contracts.js",
    "src/model/dynamic-mass-properties.js",
    "src/simulation/systems/pressure-nozzle-system.js",
    "src/simulation/systems/mass-property-commit-system.js"
  ],
  "coverageAnalysis": "off",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayDeclaration",
      "ObjectLiteral",
      "OptionalChaining",
      "MethodExpression",
      "ArrowFunction"
    ]
  },
  "concurrency": 4,
  "timeoutMS": 10000,
  "tempDirName": "artifacts/stryker-propulsion",
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": "artifacts/propulsion-mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 80,
    "break": 80
  }
}
