{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "ignorePatterns": [
    "/artifacts",
    "/coverage",
    "/dist",
    "/output",
    "/packages/core/dist",
    "/temp"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "node scripts/verify-point-contact-wrench-allocator.mjs"
  },
  "mutate": ["src/simulation/point-contact-wrench-allocator.js"],
  "coverageAnalysis": "off",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayDeclaration",
      "ObjectLiteral",
      "OptionalChaining",
      "MethodExpression",
      "ArrowFunction"
    ]
  },
  "concurrency": 4,
  "timeoutMS": 20000,
  "tempDirName": "artifacts/stryker-point-contact-wrench",
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": "artifacts/point-contact-wrench-mutation.json"
  },
  "thresholds": {
    "high": 90,
    "low": 90,
    "break": 90
  }
}
