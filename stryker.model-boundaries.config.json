{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "ignorePatterns": [
    "/artifacts",
    "/coverage",
    "/dist",
    "/output",
    "/packages/core/dist",
    "/temp"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "node scripts/verify-model-boundaries.mjs"
  },
  "mutate": [
    "src/model/blueprint-decoder.js:473-565",
    "src/application/browser-storage.js",
    "src/application/blueprint-load-transaction.js"
  ],
  "coverageAnalysis": "off",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayDeclaration",
      "ObjectLiteral",
      "OptionalChaining",
      "MethodExpression",
      "ArrowFunction"
    ]
  },
  "concurrency": 4,
  "timeoutMS": 10000,
  "tempDirName": "artifacts/stryker-model-boundaries",
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": "artifacts/model-boundaries-mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 80,
    "break": 80
  }
}
