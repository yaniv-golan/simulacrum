{
  "$id": "https://simulacrum.local/schema/mechanism-artifact-defs.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fingerprint": {
      "type": "string",
      "pattern": "^sim-sha256-[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "artifactIdentity": {
      "type": "object",
      "required": ["id", "version", "byteLength", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "sampleValue": {
      "oneOf": [
        { "type": "number" },
        { "type": "boolean" },
        { "type": "string", "maxLength": 256 },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "number" }
        }
      ]
    },
    "telemetrySample": {
      "type": "object",
      "required": [
        "channelId",
        "ownerId",
        "value",
        "unit",
        "frame",
        "phase",
        "validity",
        "saturation",
        "sourceDescriptorIds"
      ],
      "properties": {
        "channelId": { "$ref": "#/$defs/identifier" },
        "ownerId": { "$ref": "#/$defs/identifier" },
        "value": { "$ref": "#/$defs/sampleValue" },
        "unit": {
          "enum": [
            "m",
            "m/s",
            "m/s2",
            "rad",
            "rad/s",
            "N",
            "N*m",
            "N*s",
            "J",
            "W",
            "K",
            "Pa",
            "1",
            "bool"
          ]
        },
        "frame": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^(?:world|body:[A-Za-z0-9._:/-]+|frame:[A-Za-z0-9._:/-]+|contact:[A-Za-z0-9._:/-]+)$"
        },
        "phase": { "const": "committed-tick-v1" },
        "validity": {
          "enum": ["valid", "not-applicable", "unsupported-envelope", "failed"]
        },
        "saturation": { "type": "boolean" },
        "sourceDescriptorIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      },
      "additionalProperties": false
    },
    "telemetryEvent": {
      "type": "object",
      "required": [
        "eventId",
        "code",
        "ownerId",
        "predecessorIds",
        "phase",
        "sourceDescriptorIds",
        "payloadJson"
      ],
      "properties": {
        "eventId": { "$ref": "#/$defs/identifier" },
        "code": { "$ref": "#/$defs/identifier" },
        "ownerId": { "$ref": "#/$defs/identifier" },
        "predecessorIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "phase": { "const": "committed-tick-v1" },
        "sourceDescriptorIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "payloadJson": { "type": "string", "maxLength": 65536 }
      },
      "additionalProperties": false
    }
  }
}
