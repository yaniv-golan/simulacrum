{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:simulacrum:blueprint:3",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "parts", "connections"],
  "properties": {
    "environment": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["flat", "rounded-bump"]
        },
        {
          "$ref": "#/$defs/scene"
        }
      ]
    },
    "version": {
      "const": 3
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "$ref": "#/$defs/name"
    },
    "parts": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "connections": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/connection"
      }
    },
    "assemblies": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/assembly"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[\\s\\S]{1,128}$"
    },
    "position": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": -10000,
        "maximum": 10000
      }
    },
    "rotation": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name", "position", "rotation", "authoredMaterial", "parameters"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "rotation": {
          "$ref": "#/$defs/rotation"
        },
        "authoredMaterial": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "body": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "parameters": {
          "type": "object"
        },
        "authoredContact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "body": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "restitution": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "friction": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2
                }
              }
            }
          }
        }
      }
    },
    "endpoint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["part", "port"],
          "properties": {
            "part": {
              "$ref": "#/$defs/id"
            },
            "port": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["part", "surface"],
          "properties": {
            "part": {
              "$ref": "#/$defs/id"
            },
            "surface": {
              "type": "object",
              "additionalProperties": false,
              "required": ["region", "u", "v", "twist"],
              "properties": {
                "region": {
                  "type": "string"
                },
                "u": {
                  "type": "number"
                },
                "v": {
                  "type": "number"
                },
                "twist": {
                  "type": "number"
                }
              }
            }
          }
        }
      ]
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "a", "b"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": ["fixed", "pivot", "shaft", "power", "signal", "spring", "gear", "rope"]
        },
        "a": {
          "$ref": "#/$defs/endpoint"
        },
        "b": {
          "$ref": "#/$defs/endpoint"
        }
      }
    },
    "assemblyPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "endpoint"],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "endpoint": {
          "$ref": "#/$defs/endpoint"
        }
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "ids", "ports"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          }
        },
        "ports": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/assemblyPort"
          }
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objects", "ground"],
      "properties": {
        "objects": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/sceneObject"
          }
        },
        "ground": {
          "type": "object",
          "additionalProperties": false,
          "required": ["friction", "restitution"],
          "properties": {
            "friction": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "restitution": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "sceneObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "shape",
        "halfExtents",
        "position",
        "rotation",
        "material",
        "friction",
        "restitution",
        "fixed"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "shape": {
          "enum": ["box", "cylinder"]
        },
        "halfExtents": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0.005,
            "maximum": 2
          }
        },
        "position": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -10,
            "maximum": 10
          }
        },
        "rotation": {
          "$ref": "#/$defs/rotation"
        },
        "material": {
          "enum": ["aluminium", "steel", "rubber"]
        },
        "friction": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "restitution": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fixed": {
          "const": true
        }
      }
    }
  },
  "$comment": "Current catalog membership and parameter schemas are joined by generate-schema.mjs. Only save version 3 is admitted."
}
