{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "ignorePatterns": [
    "/artifacts",
    "/coverage",
    "/dist",
    "/output",
    "/packages/core/dist",
    "/temp"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "node scripts/verify-pneumatic-tire-runtime.mjs && node scripts/verify-pneumatic-ctis.mjs"
  },
  "mutate": [
    "src/simulation/pneumatic-gas.js",
    "src/simulation/pneumatic-network.js:63-232",
    "src/simulation/pneumatic-network.js:290-389",
    "src/simulation/pneumatic-network.js:871-944"
  ],
  "coverageAnalysis": "off",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayDeclaration",
      "ObjectLiteral",
      "OptionalChaining",
      "MethodExpression",
      "ArrowFunction"
    ]
  },
  "concurrency": 4,
  "timeoutMS": 10000,
  "tempDirName": "artifacts/stryker-pneumatics",
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": "artifacts/pneumatics-mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 80,
    "break": 80
  }
}
