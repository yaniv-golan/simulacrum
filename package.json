{
  "name": "simulacrum-foundry",
  "version": "2.0.0-alpha.0",
  "description": "A component-driven Three.js engineering construction sandbox.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yaniv-golan/simulacrum.git"
  },
  "engines": {
    "node": ">=24.18 <25"
  },
  "type": "module",
  "scripts": {
    "bars": "node scripts/bars.mjs",
    "bar:L1a": "node scripts/bars.mjs L1a",
    "bar:L1b": "node scripts/bars.mjs L1b",
    "bar:L1c": "node scripts/bars.mjs L1c",
    "bar:L1d": "node scripts/bars.mjs L1d",
    "bar:L2": "node scripts/bars.mjs L2",
    "bar:D1": "node scripts/bars.mjs D1",
    "bar:P1": "node scripts/bars.mjs P1",
    "bar:S1": "node scripts/bars.mjs S1",
    "gate:structural": "node scripts/gate-structural.mjs",
    "gate:M0": "node scripts/gate.mjs M0",
    "gate": "node scripts/gate.mjs",
    "rules": "node scripts/rules.mjs",
    "bar:F1": "node scripts/bars.mjs F1",
    "bar:F2": "node scripts/bars.mjs F2",
    "bar:F3": "node scripts/bars.mjs F3",
    "bar:F4": "node scripts/bars.mjs F4",
    "assess": "node scripts/assess.mjs",
    "build-fingerprint": "node scripts/build-fingerprint.mjs",
    "bar:F5": "node scripts/bars.mjs F5",
    "bar:L0": "node scripts/bars.mjs L0",
    "test:unit": "node scripts/test-affected.mjs",
    "test:all": "node scripts/test-affected.mjs --all",
    "ci": "node scripts/ci.mjs",
    "test:browser": "node scripts/verify-browser-suite.mjs all",
    "test:determinism": "node scripts/verify-m1.mjs",
    "replay": "node scripts/replay.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/check-breadth-cli.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser:smoke": "node scripts/verify-browser-suite.mjs smoke",
    "test:performance": "node scripts/verify-browser-suite.mjs performance",
    "format": "prettier --write src scripts test",
    "format:check": "prettier --check src scripts test",
    "typecheck": "node scripts/check-boundary-types.mjs",
    "docs:navigate": "node scripts/navigate.mjs",
    "rules:explain": "node scripts/explain-invariant.mjs",
    "verify:final": "node scripts/verify-final.mjs"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "ajv": "^8.20.0",
    "css-tree": "^3.2.1",
    "fast-check": "^4.9.0",
    "parse5": "^8.0.1",
    "playwright": "^1.63.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic-compat": "0.20.0",
    "three": "^0.185.1"
  },
  "moduleGraph": {
    "runtimeNetworkDependencies": {
      "src/application/remote-playtest.mjs": {
        "namespace": "/api/playtest/",
        "service": "../../scripts/playtest-server.mjs",
        "dynamicFetchArguments": [
          "next.url"
        ]
      }
    },
    "runtimeURLArguments": {
      "scripts/playtest-server.mjs": [
        "req.url",
        "req.headers.origin"
      ],
      "src/application/remote-playtest.mjs": [
        "next.url"
      ]
    }
  }
}
