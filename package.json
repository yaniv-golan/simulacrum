  "moduleGraph": {
    "runtimeNetworkDependencies": {
      "src/application/remote-playtest.mjs": {
        "namespace": "/api/playtest/",
        "dynamicFetchArguments": [
          "next.url"
        ],
        "services": [
          "../../scripts/playtest-server.mjs",
          "../../scripts/playtest/worker.mjs"
        ]
      }
    },
    "runtimeURLArguments": {
      "scripts/playtest-server.mjs": [
        "req.url",
        "req.headers.origin"
      ],
      "src/application/remote-playtest.mjs": [
        "next.url"
      ],
      "src/application/capture-outbox.mjs": [
        "value.url"
      ],
      "scripts/playtest/worker.mjs": [
        "request.url"
      ],
      "scripts/playtest/cloud-store.mjs": [
        "request.url"
      ],
      "scripts/playtest/release-control.mjs": [
        "request.url"
      ]
    }
  }
