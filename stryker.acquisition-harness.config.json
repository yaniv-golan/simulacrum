{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "ignorePatterns": [
    "/artifacts",
    "/coverage",
    "/dist",
    "/output",
    "/packages/core/dist",
    "/temp"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "node scripts/verify-executable-trust.mjs"
  },
  "mutate": [
    "src/model/blueprint-acquisition.js",
    "src/model/executable-program.js",
    "src/application/executable-trust-repository.js",
    "src/application/executable-trust-service.js"
  ],
  "coverageAnalysis": "off",
  "concurrency": 4,
  "timeoutMS": 10000,
  "tempDirName": "artifacts/stryker-acquisition-harness",
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": "artifacts/acquisition-harness-mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 80,
    "break": 80
  }
}
